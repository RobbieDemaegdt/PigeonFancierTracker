<UserControl x:Class="PigeonFancierTracker.App.TransferView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PigeonFancierTracker.App"
        xmlns:contracts="clr-namespace:PigeonFancierTracker.Core.Contracts;assembly=PigeonFancierTracker.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        MinHeight="520"
        MinWidth="980"
        Background="{DynamicResource PageBackgroundBrush}">
    <UserControl.Resources>
        <local:ExpiredStatusToVisibilityConverter x:Key="ExpiredToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" Padding="20,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Transfermarkt" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Actieve en voltooide transfers van de laatste lokale momentopnames." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton" Content="Vernieuwen" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click" Margin="0,0,12,0" />
                    <TextBlock x:Name="TransferStatusText" Text="Transfers laden…" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Style="{StaticResource AppTabControlStyle}" Margin="20,14,20,20">
            <!-- Active Transfers Tab -->
            <TabItem Header="Actieve transfers" Style="{StaticResource AppTabItemStyle}">
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0,10,10,10" Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="ActiveTransferCountText" Text="Geen actieve transfers gevonden." Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,14" />

                            <Border Background="{DynamicResource NeutralBannerBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Automatisch bieden" DockPanel.Dock="Left"
                                                   Foreground="{DynamicResource HeadingTextBrush}" FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="AutoBidToggleButton" Content="Starten"
                                                    Style="{StaticResource PrimaryButtonStyle}" FontSize="12" Padding="12,4"
                                                    Click="AutoBidToggle_Click" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DataGrid x:Name="AutoBidGrid"
                                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" MaxHeight="200" GridLinesVisibility="Horizontal" Visibility="Collapsed">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Duif" Binding="{Binding PigeonName}" Width="1.5*" />
                                            <DataGridTextColumn Header="Huidige prijs" Binding="{Binding CurrentPrice}" Width="90" />
                                            <DataGridTextColumn Header="Max prijs" Binding="{Binding MaxPrice}" Width="80" />
                                            <DataGridTextColumn Header="Koper" Binding="{Binding CurrentBuyerName}" Width="1*" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                            <DataGridTextColumn Header="Bericht" Binding="{Binding LastMessage}" Width="1.5*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="AutoBidLogText" Text="Niet gestart" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                               Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="60" />
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="ActiveTransferGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" MinHeight="120" MaxHeight="400" GridLinesVisibility="Horizontal"
                                      SelectionChanged="ActiveTransferGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Duif" Binding="{Binding PigeonName}" Width="1.5*" />
                                    <DataGridTextColumn Header="Geslacht" Binding="{Binding Sex}" Width="65" />
                                    <DataGridTextColumn Header="Leeftijd" Binding="{Binding Age}" Width="70" />
                                    <DataGridTextColumn Header="Ras" Binding="{Binding Breed}" Width="80" />
                                    <DataGridTextColumn Header="Prijs" Binding="{Binding CurrentPrice}" Width="65" />
                                    <DataGridTextColumn Header="Verkoper" Binding="{Binding Seller}" Width="1*" />
                                    <DataGridTextColumn Header="Koper" Binding="{Binding Buyer}" Width="1*" />
                                    <DataGridTextColumn Header="Biedingen" Binding="{Binding BidCount}" Width="70" />
                                    <DataGridTextColumn Header="Resterende tijd" Binding="{Binding TimeRemaining}" Width="100" />
                                    <DataGridTextColumn Header="Geschatte waarde" Binding="{Binding BestEstimateDisplay}" Width="110" />
                                    <DataGridTextColumn Header="Totaal" Binding="{Binding TotalSkillDisplay}" Width="60" />
                                    <DataGridTextColumn Header="Kort" Binding="{Binding ShortDisplay}" Width="55" />
                                    <DataGridTextColumn Header="Midden" Binding="{Binding MediumDisplay}" Width="65" />
                                    <DataGridTextColumn Header="Lang" Binding="{Binding LongDisplay}" Width="55" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <local:TransferDetailControl x:Name="ActiveDetailPanel" Visibility="Collapsed" Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Completed Transfers Tab -->
            <TabItem Header="Voltooide transfers" Style="{StaticResource AppTabItemStyle}">
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0,10,10,10" Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="CompletedTransferCountText" Text="Nog geen voltooide transfers gedetecteerd." Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,14" />
                            <DataGrid x:Name="CompletedTransferGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" MinHeight="120" MaxHeight="400" GridLinesVisibility="Horizontal"
                                      SelectionChanged="CompletedTransferGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Duif" Binding="{Binding PigeonName}" Width="1.5*" />
                                    <DataGridTextColumn Header="Duif ID" Binding="{Binding PigeonId}" Width="60" />
                                    <DataGridTextColumn Header="Geslacht" Binding="{Binding Sex}" Width="65" />
                                    <DataGridTextColumn Header="Leeftijd" Binding="{Binding Age}" Width="70" />
                                    <DataGridTextColumn Header="Ras" Binding="{Binding Breed}" Width="80" />
                                    <DataGridTemplateColumn Header="Prijs" Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CurrentPrice, Mode=OneWay}"
                                                         Tag="PriceEditor"
                                                         BorderThickness="0" Background="Transparent" Padding="2,1"
                                                         FontSize="12" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Verkoper" Binding="{Binding Seller}" Width="1*" />
                                    <DataGridTemplateColumn Header="Koper" Width="1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Buyer, Mode=OneWay}"
                                                         Tag="BuyerEditor"
                                                         BorderThickness="0" Background="Transparent" Padding="2,1"
                                                         FontSize="12" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Biedingen" Binding="{Binding BidCount}" Width="70" />
                                    <DataGridTemplateColumn Header="Status" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedItem="{Binding TimeRemaining, Mode=OneWay}"
                                                          Tag="StatusEditor"
                                                          BorderThickness="0" Background="Transparent" Padding="2,1"
                                                          FontSize="12">
                                                    <sys:String>Sold</sys:String>
                                                    <sys:String>Expired</sys:String>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Geschatte waarde" Binding="{Binding BestEstimateDisplay}" Width="110" />
                                    <DataGridTextColumn Header="Prijsverschil" Binding="{Binding PriceDeltaDisplay}" Width="85" />
                                    <DataGridTextColumn Header="Totaal" Binding="{Binding TotalSkillDisplay}" Width="60" />
                                    <DataGridTextColumn Header="Kort" Binding="{Binding ShortDisplay}" Width="55" />
                                    <DataGridTextColumn Header="Midden" Binding="{Binding MediumDisplay}" Width="65" />
                                    <DataGridTextColumn Header="Lang" Binding="{Binding LongDisplay}" Width="55" />
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="💾" ToolTip="Wijzigingen opslaan"
                                                            Click="SaveRowButton_Click"
                                                            Style="{StaticResource LinkButtonStyle}"
                                                            FontSize="12" Padding="6,2" />
                                                    <Button Content="↻" ToolTip="Hercontroleer status"
                                                            Click="RecheckButton_Click"
                                                            Style="{StaticResource LinkButtonStyle}"
                                                            FontSize="14" Padding="6,2"
                                                            Visibility="{Binding Status, Converter={StaticResource ExpiredToVisibility}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="RecheckStatusMessage" Visibility="Collapsed"
                                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                       Margin="0,6,0,0" />

                            <local:TransferDetailControl x:Name="CompletedDetailPanel" Visibility="Collapsed" Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Market Analysis Tab -->
            <TabItem Header="Marktanalyse" Style="{StaticResource AppTabItemStyle}">
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0,10,10,10" Padding="20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- KPI Banner -->
                            <Border Background="{DynamicResource NeutralBannerBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Marktoverzicht" Foreground="{DynamicResource HeadingTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <UniformGrid Columns="4">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Koopjes" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock x:Name="MarketKoopjeCountText" Text="—" Foreground="#27ae60" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Te duur" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock x:Name="MarketTeDuurCountText" Text="—" Foreground="#e74c3c" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Gem. skill/€" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock x:Name="MarketAvgSkillPerEuroText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Beste koopje" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock x:Name="MarketTopBargainText" Text="—" Foreground="#27ae60" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Price Trend -->
                            <Border Background="{DynamicResource NeutralBannerBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Prijstrend" Foreground="{DynamicResource HeadingTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <UniformGrid Columns="4">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Huidige prijs/vaard" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock x:Name="MarketCurrentPriceText" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Vorige prijs/vaard" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock x:Name="MarketPreviousPriceText" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Trend" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock x:Name="MarketTrendDirectionText" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Verschil" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock x:Name="MarketTrendPercentageText" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Auction Timing -->
                            <Border Background="{DynamicResource NeutralBannerBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Veiling timing" Foreground="{DynamicResource HeadingTextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Beste tijdslot" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock x:Name="AuctionBestSlotText" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Slechtste tijdslot" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock x:Name="AuctionWorstSlotText" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <DataGrid x:Name="AuctionTimingGrid"
                                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" MaxHeight="200" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tijdslot" Binding="{Binding TimeSlot}" Width="100" />
                                            <DataGridTextColumn Header="Gem. biedingen" Binding="{Binding AvgBidCount}" Width="100" />
                                            <DataGridTextColumn Header="Gem. prijs" Binding="{Binding AvgSoldPrice, StringFormat={}{0:N0}}" Width="90" />
                                            <DataGridTextColumn Header="Gem. premie %" Binding="{Binding AvgPremium, StringFormat={}{0:0.0}%}" Width="100" />
                                            <DataGridTextColumn Header="Aantal" Binding="{Binding SaleCount}" Width="70" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- Buy Recommendations -->
                            <TextBlock Text="Koopaanbevelingen" Foreground="{DynamicResource HeadingTextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,8" />
                            <TextBlock x:Name="BuyRecommendationCountText" Text="Geen actieve transfers om te analyseren." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,8" />
                            <DataGrid x:Name="BuyRecommendationGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" MinHeight="80" MaxHeight="350" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Duif" Binding="{Binding PigeonName}" Width="1.5*" />
                                    <DataGridTextColumn Header="Vraagprijs" Binding="{Binding AskingPrice, StringFormat=€{0:N0}}" Width="80" />
                                    <DataGridTextColumn Header="Geschat" Binding="{Binding EstimatedMarketValue, StringFormat=€{0:N0}}" Width="80" />
                                    <DataGridTextColumn Header="Verhouding" Binding="{Binding ValueRatio, StringFormat={}{0:0.00}}" Width="80" />
                                    <DataGridTextColumn Header="Skill/€" Binding="{Binding SkillPerEuro, StringFormat={}{0:0.00}}" Width="65" />
                                    <DataGridTextColumn Header="Beoordeling" Binding="{Binding ClassificationDisplay}" Width="100" />
                                    <DataGridTextColumn Header="Fase" Binding="{Binding AgePhase}" Width="65" />
                                    <DataGridTextColumn Header="Leeftijd" Binding="{Binding Age}" Width="70" />
                                    <DataGridTextColumn Header="Ras" Binding="{Binding Breed}" Width="80" />
                                    <DataGridTextColumn Header="Totaal" Binding="{Binding TotalSkill}" Width="55" />
                                    <DataGridTextColumn Header="Uitzondering" Binding="{Binding OutlierReason}" Width="1*" />
                                    <DataGridTextColumn Header="Resterend" Binding="{Binding TimeRemaining}" Width="80" />
                                    <DataGridTextColumn Header="Zekerheid" Binding="{Binding Confidence}" Width="75" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Sell Value Estimates -->
                            <TextBlock Text="Verkoopwaarde eigen duiven" Foreground="{DynamicResource HeadingTextBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,8" />
                            <TextBlock x:Name="SellEstimateCountText" Text="Geen verkoopwaarde beschikbaar." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,0,0,8" />
                            <DataGrid x:Name="SellEstimateGrid"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      HeadersVisibility="Column" MinHeight="80" MaxHeight="350" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Duif" Binding="{Binding PigeonName}" Width="1.5*" />
                                    <DataGridTextColumn Header="Geschatte prijs" Binding="{Binding EstimatedSellPrice, StringFormat=€{0:N0}}" Width="95" />
                                    <DataGridTextColumn Header="Min" Binding="{Binding MinEstimate, StringFormat=€{0:N0}}" Width="65" />
                                    <DataGridTextColumn Header="Max" Binding="{Binding MaxEstimate, StringFormat=€{0:N0}}" Width="65" />
                                    <DataGridTextColumn Header="Beoordeling" Binding="{Binding ClassificationDisplay}" Width="90" />
                                    <DataGridTextColumn Header="Totaal skill" Binding="{Binding TotalSkill}" Width="75" />
                                    <DataGridTextColumn Header="Leeftijd" Binding="{Binding Age}" Width="70" />
                                    <DataGridTextColumn Header="Ras" Binding="{Binding Breed}" Width="80" />
                                    <DataGridTextColumn Header="Beste timing" Binding="{Binding OptimalTiming}" Width="85" />
                                    <DataGridTextColumn Header="Markttrend" Binding="{Binding MarketTrendImpact}" Width="1*" />
                                    <DataGridTextColumn Header="Punten" Binding="{Binding TotalPoints}" Width="60" />
                                    <DataGridTextColumn Header="Zekerheid" Binding="{Binding Confidence}" Width="75" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

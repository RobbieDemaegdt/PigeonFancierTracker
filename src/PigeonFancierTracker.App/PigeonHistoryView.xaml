<UserControl x:Class="PigeonFancierTracker.App.PigeonHistoryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="520"
        MinWidth="820"
        Background="{DynamicResource PageBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header: title + subtitle on the left, pigeon selector + status on the right -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" Padding="20,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Duivengeschiedenis" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Alle geslaagde lokale momentopnames worden gecombineerd in de tijdlijn van elke duif. Er wordt geen nieuw spelverzoek gedaan door deze pagina." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="520" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Duif" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="PigeonSelector"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="SourceId"
                              SelectionChanged="PigeonSelector_SelectionChanged"
                              MinWidth="240"
                              Padding="8,5"
                              VerticalAlignment="Center" />
                    <TextBlock x:Name="HistoryStatusText" Text="Lokale geschiedenis laden…" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="280" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <!-- Selected-pigeon caption -->
                <TextBlock x:Name="PigeonTitleText" Text="Selecteer een duif" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="PigeonSummaryText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

                <!-- KPI summary strip -->
                <UniformGrid Columns="5" Margin="0,16,0,16">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Laatste totale vaardigheid" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="LatestTotalSkillText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Verandering sinds eerste" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="TotalSkillChangeText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Laatste premie/waarde" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="LatestPremiumText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Waarnemingen" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="ObservationCountText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Laatst waargenomen" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="LatestObservedText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Tabbed detail -->
                <TabControl Style="{StaticResource AppTabControlStyle}">

                    <!-- ============ TAB 1: Vaardigheidgeschiedenis ============ -->
                    <TabItem Header="Vaardigheidgeschiedenis" Style="{StaticResource AppTabItemStyle}">
                        <Border Style="{StaticResource CardBorderStyle}" BorderThickness="1" CornerRadius="0,10,10,10" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Elke rij vertegenwoordigt een verandering in statistieken. Dubbele momentopnames zonder wijzigingen worden verborgen." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                                <DataGrid x:Name="HistoryGrid"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" MinHeight="220" MaxHeight="560" GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Waargenomen" Binding="{Binding ObservedAtUtc, StringFormat={}{0:g}}" Width="145" />
                                        <DataGridTextColumn Header="Totaal" Binding="{Binding TotalSkillDisplay}" Width="75" />
                                        <DataGridTextColumn Header="Kort" Binding="{Binding ShortDisplay}" Width="65" />
                                        <DataGridTextColumn Header="Mid" Binding="{Binding MediumDisplay}" Width="65" />
                                        <DataGridTextColumn Header="Lang" Binding="{Binding LongDisplay}" Width="65" />
                                        <DataGridTextColumn Header="Vorm" Binding="{Binding FormDisplay}" Width="65" />
                                        <DataGridTextColumn Header="Ervaring" Binding="{Binding ExperienceDisplay}" Width="65" />
                                        <DataGridTextColumn Header="Conditie" Binding="{Binding StaminaDisplay}" Width="65" />
                                        <DataGridTextColumn Header="Snelheid" Binding="{Binding SpeedDisplay}" Width="65" />
                                        <DataGridTextColumn Header="Navigatie" Binding="{Binding NavigationDisplay}" Width="65" />
                                        <DataGridTextColumn Header="Techniek" Binding="{Binding TechniqueDisplay}" Width="65" />
                                        <DataGridTextColumn Header="Aerodyn." Binding="{Binding AerodynamicsDisplay}" Width="65" />
                                        <DataGridTextColumn Header="Intell." Binding="{Binding IntelligenceDisplay}" Width="65" />
                                        <DataGridTextColumn Header="Libido" Binding="{Binding LibidoDisplay}" Width="65" />
                                        <DataGridTextColumn Header="Nachtzicht" Binding="{Binding NightvisionDisplay}" Width="65" />
                                        <DataGridTextColumn Header="Premie" Binding="{Binding Premium, StringFormat={}{0:C2}}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ============ TAB 2: Leeftijdsanalyse ============ -->
                    <TabItem Header="Leeftijdsanalyse" Style="{StaticResource AppTabItemStyle}">
                        <Border Style="{StaticResource CardBorderStyle}" BorderThickness="1" CornerRadius="0,10,10,10" Padding="20">
                            <StackPanel>
                                <TextBlock x:Name="AgeCurveStatusText" Text="Geen leeftijdsgegevens beschikbaar." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Border x:Name="AgeCurveSummary" Background="{DynamicResource NeutralBannerBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                                    <UniformGrid Columns="4">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Piek vaardigheidsleeftijd" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock x:Name="PeakSkillAgeText" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Piek prestatieleeftijd" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock x:Name="PeakPerformanceAgeText" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Piek totale vaardigheid" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock x:Name="PeakTotalSkillText" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Fase" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                            <TextBlock x:Name="PhaseDisplayText" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>
                                <DataGrid x:Name="AgeBucketGrid"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" MaxHeight="360" GridLinesVisibility="Horizontal"
                                          Visibility="Collapsed">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Leeftijd" Binding="{Binding AgeDisplay}" Width="90" />
                                        <DataGridTextColumn Header="Gem. vaardigheid" Binding="{Binding AvgTotalSkill, StringFormat={}{0:0.0}}" Width="120" />
                                        <DataGridTextColumn Header="Gem. percentiel" Binding="{Binding AvgPercentile, StringFormat={}{0:0.0}%}" Width="110" />
                                        <DataGridTextColumn Header="Waarnemingen" Binding="{Binding ObservationCount}" Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ============ TAB 3: Ziekte-impact ============ -->
                    <TabItem Header="Ziekte-impact" Style="{StaticResource AppTabItemStyle}">
                        <Border Style="{StaticResource CardBorderStyle}" BorderThickness="1" CornerRadius="0,10,10,10" Padding="20">
                            <StackPanel>
                                <TextBlock x:Name="DiseaseImpactStatusText" Text="Geen ziekte-episodes gedetecteerd." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <Border x:Name="DiseaseImpactSummary" Background="{DynamicResource NeutralBannerBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Totaal episodes" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock x:Name="TotalEpisodesText" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Gem. vaardigheidsverlies" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock x:Name="AvgSkillLossText" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Gem. herstel %" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock x:Name="AvgRecoveryText" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </UniformGrid>
                                </Border>
                                <DataGrid x:Name="DiseaseEpisodesGrid"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                          HeadersVisibility="Column" MaxHeight="360" GridLinesVisibility="Horizontal"
                                          Visibility="Collapsed">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ziekte" Binding="{Binding DiseaseName}" Width="120" />
                                        <DataGridTextColumn Header="Gestart" Binding="{Binding StartedAt, StringFormat={}{0:dd-MM-yyyy}}" Width="100" />
                                        <DataGridTextColumn Header="Beëindigd" Binding="{Binding EndedAt, StringFormat={}{0:dd-MM-yyyy}}" Width="100" />
                                        <DataGridTextColumn Header="Snapshots" Binding="{Binding DurationSnapshots}" Width="75" />
                                        <DataGridTextColumn Header="Vaard. voor" Binding="{Binding SkillBefore, StringFormat={}{0:0.0}}" Width="85" />
                                        <DataGridTextColumn Header="Vaard. laagste" Binding="{Binding SkillWorst, StringFormat={}{0:0.0}}" Width="100" />
                                        <DataGridTextColumn Header="Vaard. na" Binding="{Binding SkillAfter, StringFormat={}{0:0.0}}" Width="75" />
                                        <DataGridTextColumn Header="Verlies" Binding="{Binding SkillLoss, StringFormat={}{0:0.0}}" Width="60" />
                                        <DataGridTextColumn Header="Netto impact" Binding="{Binding NetImpact, StringFormat={}{0:+0.0;-0.0}}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </TabItem>

                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<Window x:Class="PigeonFancierTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Duivenmelker Tracker" Height="820" Width="1480" MinHeight="620" MinWidth="1180">
    <Grid Background="{DynamicResource PageBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource HeaderBrush}" Padding="16,20">
            <Border.Resources>
                <Style x:Key="SidebarButtonStyle" TargetType="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Padding" Value="12,9" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#24FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Background" Value="#24FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Duivenmelker" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Tracker" Foreground="{DynamicResource HeaderSubtitleBrush}" FontSize="15" />
                    <Border Background="#1FFFFFFF" CornerRadius="4" Padding="7,3" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <TextBlock Text="ALLEEN LEZEN" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,24,0,12">
                    <StackPanel>
                        <TextBlock Text="OVERZICHT" Foreground="{DynamicResource HeaderSubtitleBrush}" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,5" />
                        <Button x:Name="DashboardNavButton" Content="Hokoverzicht" Style="{StaticResource SidebarButtonStyle}" Click="OpenDashboard_Click" IsDefault="True" Background="#2EFFFFFF" FontWeight="SemiBold" />

                        <TextBlock Text="DUIVEN" Foreground="{DynamicResource HeaderSubtitleBrush}" FontSize="10" FontWeight="SemiBold" Margin="12,18,0,5" />
                        <Button x:Name="HistoryNavButton" Content="Duivengeschiedenis" Style="{StaticResource SidebarButtonStyle}" Click="OpenPigeonHistory_Click" />

                        <TextBlock Text="WEDSTRIJDEN" Foreground="{DynamicResource HeaderSubtitleBrush}" FontSize="10" FontWeight="SemiBold" Margin="12,18,0,5" />
                        <Button x:Name="FlightsNavButton" Content="Vluchten" Style="{StaticResource SidebarButtonStyle}" Click="OpenFlights_Click" />
                        <Button x:Name="RankingNavButton" Content="Klassement" Style="{StaticResource SidebarButtonStyle}" Click="OpenRanking_Click" />

                        <TextBlock Text="MARKT &amp; INKOMEN" Foreground="{DynamicResource HeaderSubtitleBrush}" FontSize="10" FontWeight="SemiBold" Margin="12,18,0,5" />
                        <Button x:Name="TransferNavButton" Content="Transfers" Style="{StaticResource SidebarButtonStyle}" Click="OpenTransfers_Click" />
                        <Button x:Name="SponsorNavButton" Content="Sponsoring" Style="{StaticResource SidebarButtonStyle}" Click="OpenSponsors_Click" />

                        <TextBlock Text="SYSTEEM" Foreground="{DynamicResource HeaderSubtitleBrush}" FontSize="10" FontWeight="SemiBold" Margin="12,18,0,5" />
                        <Button x:Name="ConnectionNavButton" Content="Verbinding" Style="{StaticResource SidebarButtonStyle}" Click="OpenConnection_Click" />
                        <Button x:Name="DataNavButton" Content="Gegevens &amp; instellingen" Style="{StaticResource SidebarButtonStyle}" Click="OpenData_Click" />
                    </StackPanel>
                </ScrollViewer>

                <Button x:Name="ThemeToggleButton" Grid.Row="2" Content="&#x263D; Donker thema"
                        Style="{StaticResource ThemeToggleButtonStyle}" Click="ThemeToggle_Click" HorizontalAlignment="Left" />
            </Grid>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ShellPageTitle" Text="Hokoverzicht" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="ShellPageSubtitle" Text="Lokale gegevens voor de geselecteerde melker" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionStatusText" Text="Verbind je account" Foreground="{DynamicResource HeadingTextBrush}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                        <TextBlock x:Name="HeaderFancierText" Text="Geen melker geselecteerd" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                        <TextBlock x:Name="HeaderSeasonText" Text="" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="10,0,0,0" />
                        <TextBlock x:Name="SyncStatusText" Text="Sync inactief" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Grid.Row="1">
            <Grid x:Name="DashboardPage" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Border x:Name="DashboardStatusBanner" Background="{DynamicResource NeutralBannerBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
                            <DockPanel>
                                <Ellipse x:Name="ConnectionIndicator" Width="12" Height="12" Fill="#9E9E9E" VerticalAlignment="Center" Margin="4,0,10,0" />
                                <Button x:Name="DashboardPrimaryAction" DockPanel.Dock="Right" Content="Naar verbinding" Style="{StaticResource SecondaryButtonStyle}" Click="DashboardPrimaryAction_Click" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DashboardStatusTitle" Text="Offline" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DashboardLastCheckedText" Text="" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Geselecteerde melker" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="SelectedFancierText" Text="Geen melker geselecteerd" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" /><TextBlock x:Name="FancierLocationText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel></Border>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Hok" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="PenCapacityText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="bezet / capaciteit" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel></Border>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Laatste sync" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="LastSyncText" Text="Niet uitgevoerd" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                            <Border Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="Seizoen" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="SeasonText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                        </UniformGrid>

                        <TabControl Style="{StaticResource AppTabControlStyle}" SelectionChanged="DashboardTabControl_SelectionChanged">
                            <TabItem Header="Hok Overzicht" Style="{StaticResource AppTabItemStyle}">
                                <Border Style="{StaticResource CardBorderStyle}" BorderThickness="1" CornerRadius="0,10,10,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Lokale data momentopname" Foreground="{DynamicResource HeadingTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="DataMessageText" Text="Selecteer een melker en voer een sync uit om lokale data te laden." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Content="Lokale data verversen" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshData_Click" />
                                            </StackPanel>
                                        </DockPanel>

                                        <UniformGrid Columns="5" Margin="0,14,0,10">
                                            <StackPanel><TextBlock Text="Duiven" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="DataPigeonCountText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                            <StackPanel><TextBlock Text="Kapitaal" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="DataCapitalText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock x:Name="DataFoodText" Text="" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" /></StackPanel>
                                            <StackPanel><TextBlock Text="Gem. vaardigheid" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="DataAverageSkillText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                            <StackPanel><TextBlock Text="Gem. vaardigheidwijziging" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="DataAverageSkillChangeText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                            <StackPanel><TextBlock Text="Laatst vastgelegd" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="DataLastCapturedText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel>
                                        </UniformGrid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*" MinWidth="500" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="3*" MinWidth="280" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBox x:Name="PigeonSearchBox" Style="{StaticResource SearchTextBoxStyle}" Margin="0,0,0,10" TextChanged="PigeonSearchBox_TextChanged" />
                                                <DataGrid x:Name="PigeonGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                                          HeadersVisibility="Column" MinHeight="280" MaxHeight="600" GridLinesVisibility="Horizontal"
                                                          SelectionMode="Single" SelectionChanged="PigeonGrid_SelectionChanged" Cursor="Hand">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Duif" Binding="{Binding DisplayName}" Width="*" MinWidth="120" />
                                                        <DataGridTextColumn Header="Leeftijd" Binding="{Binding Age}" Width="68" />
                                                        <DataGridTextColumn Header="Totaal" Binding="{Binding TotalSkillDisplay}" Width="58" />
                                                        <DataGridTextColumn Header="Kort" Binding="{Binding ShortDisplay}" Width="52" />
                                                        <DataGridTextColumn Header="Mid" Binding="{Binding MediumDisplay}" Width="52" />
                                                        <DataGridTextColumn Header="Lang" Binding="{Binding LongDisplay}" Width="52" />
                                                        <DataGridTextColumn Header="Gezondheid" Binding="{Binding Disease, TargetNullValue=—}" Width="82" />
                                                        <DataGridTextColumn Header="Δ" Binding="{Binding SkillChange, StringFormat={}{0:+0;-0;—}}" Width="44" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="{DynamicResource PageBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                                <StackPanel>
                                                    <TextBlock Text="Geselecteerde duif" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="PigeonDetailTitleText" Text="Selecteer een duif" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="PigeonDetailIdentityText" Text="De eerste beschikbare duif wordt automatisch geselecteerd." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,14" TextWrapping="Wrap" />

                                                    <TextBlock Text="Status" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                                    <TextBlock x:Name="PigeonDetailHealthText" Text="—" Foreground="{DynamicResource BodyTextBrush}" Margin="0,3,0,12" TextWrapping="Wrap" />

                                                    <TextBlock Text="Wedstrijden" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                                    <TextBlock x:Name="PigeonDetailRaceText" Text="—" Foreground="{DynamicResource BodyTextBrush}" Margin="0,3,0,12" TextWrapping="Wrap" />

                                                    <TextBlock Text="Waarde" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                                    <TextBlock x:Name="PigeonDetailFinanceText" Text="—" Foreground="{DynamicResource BodyTextBrush}" Margin="0,3,0,12" TextWrapping="Wrap" />

                                                    <TextBlock Text="Vaardigheden" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                                    <TextBlock x:Name="PigeonDetailSkillsText" Text="—" Foreground="{DynamicResource BodyTextBrush}" Margin="0,3,0,18" TextWrapping="Wrap" />

                                                    <Button x:Name="OpenPigeonHistoryButton" Content="Volledige geschiedenis" Style="{StaticResource PrimaryButtonStyle}"
                                                            Click="OpenSelectedPigeonHistory_Click" IsEnabled="False" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                            <TabItem Header="Duivenoverzicht (historisch)" Style="{StaticResource AppTabItemStyle}">
                                <Border Style="{StaticResource CardBorderStyle}" BorderThickness="1" CornerRadius="0,10,10,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Historisch overzicht" Foreground="{DynamicResource HeadingTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="OverviewMessageText" Text="Selecteer een melker en voer een sync uit om historische data te laden." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right" Content="Historisch overzicht verversen" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshOverview_Click" VerticalAlignment="Top" />
                                        </DockPanel>

                                        <UniformGrid Columns="4" Margin="0,14,0,10">
                                            <StackPanel><TextBlock Text="Duiven" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="OverviewPigeonCountText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                            <StackPanel><TextBlock Text="Totaal waarnemingen" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="OverviewObservationCountText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                            <StackPanel><TextBlock Text="Oudste momentopname" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="OverviewOldestText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel>
                                            <StackPanel><TextBlock Text="Nieuwste momentopname" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="OverviewNewestText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel>
                                        </UniformGrid>

                                        <TextBox x:Name="OverviewSearchBox" Style="{StaticResource SearchTextBoxStyle}" Margin="0,0,0,10" TextChanged="OverviewSearchBox_TextChanged" />

                                        <DataGrid x:Name="OverviewPigeonGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" MinHeight="180" MaxHeight="600" GridLinesVisibility="Horizontal">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Duif" Binding="{Binding DisplayName}" Width="1.5*" />
                                                <DataGridTextColumn Header="Gesl" Binding="{Binding Sex}" Width="50" />
                                                <DataGridTextColumn Header="Leeftijd" Binding="{Binding Age}" Width="70" />
                                                <DataGridTextColumn Header="Ras" Binding="{Binding Breed}" Width="80" />
                                                <DataGridTextColumn Header="&#x2665;" Binding="{Binding BreedingMark}" Width="30" />
                                                <DataGridTextColumn Header="Totaal" Binding="{Binding TotalSkillDisplay}" Width="65" />
                                                <DataGridTextColumn Header="Kort" Binding="{Binding ShortDisplay}" Width="55" />
                                                <DataGridTextColumn Header="Mid" Binding="{Binding MediumDisplay}" Width="55" />
                                                <DataGridTextColumn Header="Lang" Binding="{Binding LongDisplay}" Width="55" />
                                                <DataGridTextColumn Header="Vorm" Binding="{Binding FormDisplay}" Width="60" />
                                                <DataGridTextColumn Header="Ervaring" Binding="{Binding ExperienceDisplay}" Width="60" />
                                                <DataGridTextColumn Header="Conditie" Binding="{Binding StaminaDisplay}" Width="60" />
                                                <DataGridTextColumn Header="Snelheid" Binding="{Binding SpeedDisplay}" Width="60" />
                                                <DataGridTextColumn Header="Navigatie" Binding="{Binding NavigationDisplay}" Width="60" />
                                                <DataGridTextColumn Header="Techniek" Binding="{Binding TechniqueDisplay}" Width="60" />
                                                <DataGridTextColumn Header="Aerodyn." Binding="{Binding AerodynamicsDisplay}" Width="60" />
                                                <DataGridTextColumn Header="Intell." Binding="{Binding IntelligenceDisplay}" Width="60" />
                                                <DataGridTextColumn Header="Libido" Binding="{Binding LibidoDisplay}" Width="60" />
                                                <DataGridTextColumn Header="Nachtzicht" Binding="{Binding NightvisionDisplay}" Width="60" />
                                                <DataGridTextColumn Header="Vaard &#x0394;" Binding="{Binding SkillChange, StringFormat={}{0:+0;-0;—}}" Width="65" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </TabItem>

                            <TabItem Header="Fokanalyse" Style="{StaticResource AppTabItemStyle}">
                                <Border Style="{StaticResource CardBorderStyle}" BorderThickness="1" CornerRadius="0,10,10,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Fokanalyse" Foreground="{DynamicResource HeadingTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="BreedingStatusText" Text="Klik op dit tabblad om fokgegevens te laden." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right" Content="Fokanalyse verversen" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshBreeding_Click" VerticalAlignment="Top" />
                                        </DockPanel>
                                        <UniformGrid Columns="3" Margin="0,10,0,10">
                                            <StackPanel><TextBlock Text="Koppels geanalyseerd" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="BreedingPairCountText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                            <StackPanel><TextBlock Text="Gem. inteeltcoëfficiënt" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="FlockInbreedingText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                            <StackPanel><TextBlock Text="Duiven met stamboom" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock x:Name="PedigreeCountText" Text="—" Foreground="{DynamicResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="Nakomelingprestatie per koppel" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,6" />
                                        <DataGrid x:Name="BreedingPairGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" MaxHeight="280" GridLinesVisibility="Horizontal">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Doffer" Binding="{Binding PigeonName}" Width="1.2*" />
                                                <DataGridTextColumn Header="Duivin" Binding="{Binding PartnerName}" Width="1.2*" />
                                                <DataGridTextColumn Header="Nakomelingen" Binding="{Binding OffspringCount}" Width="100" />
                                                <DataGridTextColumn Header="Gem. nakom. skill" Binding="{Binding AvgOffspringTotalSkill, StringFormat=N1, TargetNullValue=—}" Width="120" />
                                                <DataGridTextColumn Header="Gem. ouder skill" Binding="{Binding ParentAvgTotalSkill, StringFormat=N1}" Width="110" />
                                                <DataGridTextColumn Header="Delta" Binding="{Binding SkillDeltaDisplay}" Width="90" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="Inteeltrapport" Foreground="{DynamicResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,6" />
                                        <DataGrid x:Name="InbreedingGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" MaxHeight="280" GridLinesVisibility="Horizontal">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Duif" Binding="{Binding PigeonName}" Width="1.5*" />
                                                <DataGridTextColumn Header="Stamboomdiepte" Binding="{Binding LineageDepth}" Width="110" />
                                                <DataGridTextColumn Header="Gem. voorouders" Binding="{Binding CommonAncestorCount}" Width="120" />
                                                <DataGridTextColumn Header="Inteelt" Binding="{Binding InbreedingDisplay}" Width="140" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="ConnectionPage" Visibility="Collapsed"><ContentControl x:Name="ConnectionHost" /></Grid>
            <Grid x:Name="HistoryPage" Visibility="Collapsed"><ContentControl x:Name="HistoryHost" /></Grid>
            <Grid x:Name="TransferPage" Visibility="Collapsed"><ContentControl x:Name="TransferHost" /></Grid>
            <Grid x:Name="FlightsPage" Visibility="Collapsed"><ContentControl x:Name="FlightsHost" /></Grid>
            <Grid x:Name="RankingPage" Visibility="Collapsed"><ContentControl x:Name="RankingHost" /></Grid>
            <Grid x:Name="SponsorPage" Visibility="Collapsed"><ContentControl x:Name="SponsorHost" /></Grid>
            <Grid x:Name="DataPage" Visibility="Collapsed"><ContentControl x:Name="DataHost" /></Grid>
        </Grid>
    </Grid>
</Window>

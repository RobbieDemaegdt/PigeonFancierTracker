<Window x:Class="PigeonFancierTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Duivenmelker Tracker" Height="820" Width="1480" MinHeight="620" MinWidth="1180">
    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="28,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Duivenmelker Tracker" Foreground="White" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Alleen-lezen lokale assistent" Foreground="#BFD7EA" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock x:Name="SessionStatusText" Text="Verbind je account" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock x:Name="HeaderFancierText" Text="Geen melker geselecteerd" Foreground="#BFD7EA" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0" />
                    <TextBlock x:Name="HeaderSeasonText" Text="" Foreground="#BFD7EA" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0" />
                    <TextBlock x:Name="SyncStatusText" Text="Sync inactief" Foreground="#BFD7EA" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="DashboardNavButton" Content="Dashboard" Style="{StaticResource NavigationButtonStyle}" Click="OpenDashboard_Click" IsDefault="True" />
                <Button x:Name="ConnectionNavButton" Content="Verbinding" Style="{StaticResource NavigationButtonStyle}" Click="OpenConnection_Click" />
                <Button x:Name="HistoryNavButton" Content="Duivengeschiedenis" Style="{StaticResource NavigationButtonStyle}" Click="OpenPigeonHistory_Click" />
                <Button x:Name="TransferNavButton" Content="Transfers" Style="{StaticResource NavigationButtonStyle}" Click="OpenTransfers_Click" />
                <Button x:Name="DataNavButton" Content="Gegevens" Style="{StaticResource NavigationButtonStyle}" Click="OpenData_Click" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid x:Name="DashboardPage" Visibility="Visible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                            <Border x:Name="DashboardStatusBanner" Background="{StaticResource NeutralBannerBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
                                <DockPanel>
                                    <Ellipse x:Name="ConnectionIndicator" Width="12" Height="12" Fill="#9E9E9E" VerticalAlignment="Center" Margin="4,0,10,0" />
                                    <Button x:Name="DashboardPrimaryAction" DockPanel.Dock="Right" Content="Naar verbinding" Style="{StaticResource SecondaryButtonStyle}" Click="DashboardPrimaryAction_Click" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="DashboardStatusTitle" Text="Offline" Foreground="{StaticResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DashboardLastCheckedText" Text="" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Geselecteerde melker" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="SelectedFancierText" Text="Geen melker geselecteerd" Foreground="{StaticResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" /><TextBlock x:Name="FancierLocationText" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Hok" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="PenCapacityText" Text="—" Foreground="{StaticResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock Text="bezet / capaciteit" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Laatste sync" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="LastSyncText" Text="Niet uitgevoerd" Foreground="{StaticResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource CardBorderStyle}"><StackPanel><TextBlock Text="Seizoen" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="SeasonText" Text="—" Foreground="{StaticResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel></Border>
                            </UniformGrid>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Lokale data momentopname" Foreground="{StaticResource HeadingTextBrush}" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="DataMessageText" Text="Selecteer een melker en voer een sync uit om lokale data te laden." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel><Button DockPanel.Dock="Right" Content="Lokale data verversen" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshData_Click" /></DockPanel>
                                    <UniformGrid Columns="5" Margin="0,14,0,10">
                                        <StackPanel><TextBlock Text="Duiven" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="DataPigeonCountText" Text="—" Foreground="{StaticResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                        <StackPanel><TextBlock Text="Kapitaal" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="DataCapitalText" Text="—" Foreground="{StaticResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /><TextBlock x:Name="DataFoodText" Text="" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" /></StackPanel>
                                        <StackPanel><TextBlock Text="Gem. vaardigheid" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="DataAverageSkillText" Text="—" Foreground="{StaticResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                        <StackPanel><TextBlock Text="Gem. vaardigheidwijziging" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="DataAverageSkillChangeText" Text="—" Foreground="{StaticResource HeadingTextBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
                                        <StackPanel><TextBlock Text="Laatst vastgelegd" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="DataLastCapturedText" Text="—" Foreground="{StaticResource HeadingTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel>
                                    </UniformGrid>
                                    <DataGrid x:Name="PigeonGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" MinHeight="180" MaxHeight="600" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Duif" Binding="{Binding DisplayName}" Width="1.5*" />
                                            <DataGridTextColumn Header="Gesl" Binding="{Binding Sex}" Width="50" />
                                            <DataGridTextColumn Header="Leeftijd" Binding="{Binding Age}" Width="70" />
                                            <DataGridTextColumn Header="♥" Binding="{Binding BreedingMark}" Width="30" />
                                            <DataGridTextColumn Header="Totaal" Binding="{Binding TotalSkillDisplay}" Width="65" />
                                            <DataGridTextColumn Header="Kort" Binding="{Binding ShortDisplay}" Width="55" />
                                            <DataGridTextColumn Header="Mid" Binding="{Binding MediumDisplay}" Width="55" />
                                            <DataGridTextColumn Header="Lang" Binding="{Binding LongDisplay}" Width="55" />
                                            <DataGridTextColumn Header="Vrm" Binding="{Binding FormDisplay}" Width="60" />
                                            <DataGridTextColumn Header="Erv" Binding="{Binding ExperienceDisplay}" Width="60" />
                                            <DataGridTextColumn Header="Con" Binding="{Binding StaminaDisplay}" Width="60" />
                                            <DataGridTextColumn Header="Snh" Binding="{Binding SpeedDisplay}" Width="60" />
                                            <DataGridTextColumn Header="Nav" Binding="{Binding NavigationDisplay}" Width="60" />
                                            <DataGridTextColumn Header="Tec" Binding="{Binding TechniqueDisplay}" Width="60" />
                                            <DataGridTextColumn Header="Aer" Binding="{Binding AerodynamicsDisplay}" Width="60" />
                                            <DataGridTextColumn Header="Int" Binding="{Binding IntelligenceDisplay}" Width="60" />
                                            <DataGridTextColumn Header="Lib" Binding="{Binding LibidoDisplay}" Width="60" />
                                            <DataGridTextColumn Header="Nz" Binding="{Binding NightvisionDisplay}" Width="60" />
                                            <DataGridTextColumn Header="Ziekte" Binding="{Binding Disease}" Width="75" />
                                            <DataGridTextColumn Header="Vaard Δ" Binding="{Binding SkillChange, StringFormat={}{0:+0;-0;—}}" Width="65" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Border x:Name="ConnectionPage" Visibility="Collapsed" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="20"><ContentControl x:Name="ConnectionHost" /></Border>
                <Border x:Name="HistoryPage" Visibility="Collapsed" Background="{StaticResource PageBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="20"><ContentControl x:Name="HistoryHost" /></Border>
                <Border x:Name="TransferPage" Visibility="Collapsed" Background="{StaticResource PageBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="20"><ContentControl x:Name="TransferHost" /></Border>
                <Border x:Name="DataPage" Visibility="Collapsed" Background="{StaticResource PageBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="20"><ContentControl x:Name="DataHost" /></Border>
        </Grid>
    </Grid>
</Window>
